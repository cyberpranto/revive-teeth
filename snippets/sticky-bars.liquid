{% assign product = all_products[section.settings.product] %}
{% assign variant = product.selected_or_first_available_variant %}

<div
  class="sticky-bar"
  id="stickyBar"
  data-product-id="{{ product.id }}"
>
  <div class="sticky-inner">

    <button class="sb-info" id="sbInfo" type="button">

      <span class="l1" id="sbL1">
        {{ product.title }}
        ·
        {{ variant.title }}
        ·
        {{ variant.price | money }}
      </span>

      <span class="l2">
        Paid at checkout · 3-pay plan available
      </span>

    </button>

    <button
      class="sb-cta"
      id="sbCta"
      data-variant-id="{{ variant.id }}"
    >
      Add To Cart
    </button>

  </div>
</div>

<script>
  window.reviveProduct = {{ product | json }};
  document
  .getElementById("sbCta")
  ?.addEventListener("click", async () => {

    const variantId =
      document
        .getElementById("sbCta")
        .dataset
        .variantId;

    await fetch("/cart/add.js", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1
      })
    });

    window.location.href = "/checkout";

});
</script>