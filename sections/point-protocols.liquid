<section class="navy" id="protocol">
  <div class="wrap">
    <div class="sect-head">
      <div class="eyebrow on-navy">
        {{ section.settings.eyebrow }}
      </div>

      <h2 class="display" style="margin-top:14px">
        {{ section.settings.heading }}
      </h2>

      <p class="sub">
        {{ section.settings.description }}
      </p>
    </div>

    <div class="protocol-stack">
      {% for block in section.blocks %}
        <article
          class="pcard2"
          {% if forloop.index > 2 %}
          data-collapsible="true"
          {% endif %}
          {{ block.shopify_attributes }}>
          <div class="diagram">
            {% case forloop.index %}
              {% when 1 %}
                {% render 'protocol-svg-1' %}
              {% when 2 %}
                {% render 'protocol-svg-2' %}
              {% when 3 %}
                {% render 'protocol-svg-3' %}
              {% when 4 %}
                {% render 'protocol-svg-4' %}
              {% when 5 %}
                {% render 'protocol-svg-5' %}
              {% when 6 %}
                {% render 'protocol-svg-6' %}
              {% when 7 %}
                {% render 'protocol-svg-7' %}
            {% endcase %}
          </div>
          <div>
            <span class="num">
              {{ block.settings.number }}
            </span>

            <h3>
              {{ block.settings.title }}
            </h3>

            <p class="pdesc">
              {{ block.settings.description }}
            </p>

            <p class="pfail">
              <strong>
                {{ block.settings.failure_heading }}
              </strong>
              {{ block.settings.failure_text }}
            </p>

            <p class="pmeans">
              <strong>
                {{ block.settings.result_heading }}
              </strong>
              {{ block.settings.result_text }}
            </p>
          </div>
        </article>
      {% endfor %}
    </div>

    <button
      class="protocol-toggle-all"
      id="protocolToggleAll"
      aria-expanded="false">
      {{ section.settings.toggle_button_text }}
    </button>

    <p class="closing-line">
      {{ section.settings.closing_line }}
    </p>
  </div>
</section>

{% schema %}
  {
    "name": "Smile Design Protocol",
    "settings": [
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow",
        "default": "The 7-Point Smile Design Protocol"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Seven design decisions on every case."
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Most snap-on veneer companies ship whatever comes off the line. Revive Veneers is designed against a seven-point protocol Dr. Turley developed in his cosmetic dental practice. Every case. If it doesn't pass, it doesn't ship."
      },
      {
        "type": "text",
        "id": "toggle_button_text",
        "label": "Toggle Button Text",
        "default": "Show all 7 steps →"
      }, {
        "type": "text",
        "id": "closing_line",
        "label": "Closing Line",
        "default": "Each case is designed by Dr. Brandon Turley, DDS — a practicing cosmetic dentist."
      }
    ],
    "blocks": [
      {
        "type": "protocol_step",
        "name": "Protocol Step",
        "settings": [
          {
            "type": "text",
            "id": "number",
            "label": "Step Number",
            "default": "01"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description"
          },
          {
            "type": "text",
            "id": "failure_heading",
            "label": "Failure Heading",
            "default": "Common failure"
          }, {
            "type": "textarea",
            "id": "failure_text",
            "label": "Failure Text"
          }, {
            "type": "text",
            "id": "result_heading",
            "label": "Result Heading",
            "default": "What this means for you"
          }, {
            "type": "textarea",
            "id": "result_text",
            "label": "Result Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Smile Design Protocol",
        "blocks": [
          {
            "type": "protocol_step",
            "settings": {
              "number": "01",
              "title": "Smile Architecture",
              "description": "How the smile sits on your face. Proportion, symmetry, presence. Dr. Turley evaluates how the veneers will frame your specific facial structure, not against a generic template.",
              "failure_heading": "Common failure in cheap snap-ons",
              "failure_text": "Cheap snap-ons use one universal shape regardless of face shape, making them look obviously fake on anyone whose face proportions don't match the mold.",
              "result_heading": "What this means for you",
              "result_text": "Your veneers will look proportional to your face, not like you're wearing someone else's smile."
            }
          },
          {
            "type": "protocol_step",
            "settings": {
              "number": "02",
              "title": "Bite Mapping",
              "description": "Ensuring the veneers work with your natural bite, not against it. The protocol verifies clearance for chewing and speech without forcing pressure on adjacent teeth.",
              "failure_heading": "How generic snap-ons get this wrong",
              "failure_text": "Generic snap-ons can shift when you talk or eat because they weren't designed against your specific bite, leading to lisping, clicking sounds, and discomfort.",
              "result_heading": "What this means for you",
              "result_text": "Your veneers stay put when you eat, talk, or laugh. No clicking sounds. No shifting."
            }
          },
          {
            "type": "protocol_step",
            "settings": {
              "number": "03",
              "title": "Tooth Proportions",
              "description": "Width-to-height ratios refined per tooth, not factory-default. Each tooth on the veneer is individually proportioned: central incisors slightly wider than laterals, canines with a subtle point, premolars with appropriate width.",
              "failure_heading": "Why factory veneers fail here",
              "failure_text": "Cheap snap-ons make every tooth the same width and shape. The result reads as obviously artificial on close inspection, especially in photos.",
              "result_heading": "What this means for you",
              "result_text": "Your veneers look like a refined version of natural teeth, not a row of identical white tiles."
            }
          },
          {
            "type": "protocol_step",
            "settings": {
              "number": "04",
              "title": "Gumline Design",
              "description": "How the veneers meet your gums. The protocol designs the gumline contour to follow your natural gum architecture, with appropriate thickness reduction at the margin.",
              "failure_heading": "The most visible flaw in cheap snap-ons",
              "failure_text": "The #1 visual giveaway of cheap snap-ons is the visible plastic gap between the veneer edge and the gum. It looks fake from across a room.",
              "result_heading": "What this means for you",
              "result_text": "When you smile, no one sees a plastic line between your teeth and your gums."
            }
          }, {
            "type": "protocol_step",
            "settings": {
              "number": "05",
              "title": "Edge Aesthetics",
              "description": "Translucency and finish at the biting edge, so teeth read like enamel, not plastic. Natural teeth have a subtle translucency at the edge. The protocol replicates this property in the resin.",
              "failure_heading": "Where mass-market veneers break down",
              "failure_text": "Most snap-on veneers use uniform-opacity plastic that reads as obviously fake in any photo where the biting edge is visible.",
              "result_heading": "What this means for you",
              "result_text": "Your teeth look like enamel in photos, video calls, and direct sunlight. Not like a costume."
            }
          }, {
            "type": "protocol_step",
            "settings": {
              "number": "06",
              "title": "Shade Selection",
              "description": "Color matched to your skin tone and natural tooth shade, in three shade options from natural to brilliant white. The protocol selects the shade that will read as your teeth, refined rather than obviously veneered.",
              "failure_heading": "How off-the-shelf veneers miss",
              "failure_text": "Generic veneers come in one shade: aggressive Hollywood white. Against most skin tones, this reads as immediately fake.",
              "result_heading": "What this means for you",
              "result_text": "You choose the shade that fits your face. Subtle improvement or noticeable upgrade, both look authentic."
            }
          }, {
            "type": "protocol_step",
            "settings": {
              "number": "07",
              "title": "Final Verification",
              "description": "Quality check against the design before shipping. Every veneer is inspected against the original design specifications. If it doesn't match the spec (wrong proportions, wrong shade, gumline off, edge incorrect), it doesn't ship. It's remade.",
              "failure_heading": "What other companies skip",
              "failure_text": "Most snap-on companies ship whatever comes off the production line, defects included. Your remake comes out of your refund window, not theirs.",
              "result_heading": "What this means for you",
              "result_text": "If your veneers arrive and don't match the design Dr. Turley approved, we remake them. You don't pay for our mistakes."
            }
          }
        ]
      }
    ]
  }
{% endschema %}