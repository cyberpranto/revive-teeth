{% assign product = section.settings.product %}

{% if product == blank %}
  <p>Select a product in theme customizer.</p>
  {% break %}
{% endif %}

{% assign current_variant = product.selected_or_first_available_variant %}

<section class="hero" style="padding-top:48px">
  <div class="wrap hero-grid">
    <!-- < !-- Gallery -->
    <div class="gallery">
      <div class="gallery-main">
        <img
          id="galImg"
          src="{{ product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.title }}"
          width="1200"
          height="1200"
        >
      </div>

      <div class="thumbs">
        {% for image in product.images %}
          <button
            class="thumb {% if forloop.first %}active{% endif %}"
            data-image="{{ image | image_url: width: 1200 }}"
          >
            <img
              src="{{ image | image_url: width: 200 }}"
              alt="{{ image.alt }}"
              width="200"
              height="200"
            >
          </button>
        {% endfor %}
      </div>
    </div>
    <div class="buybox">
      <div class="eyebrow-sm">Designed by Dr. Brandon Turley, DDS</div>
      <div class="cred-strip">
        DDS
        <span class="dot">· </span>
        12+years clinical practice
        <span class="dot">· </span>
        7-Point design protocol
        <span class="dot">· </span>
        Designed in the USA
      </div>
      <h1 class="display">
        {{ section.settings.heading }}
      </h1>
      <p class="lead">
        {{ section.settings.description }}
      </p>
      <hr>
      <div class="config-label">
        Configuration
        <span class="req">· Choose one </span>
      </div>
      <div
        class="config"
        id="config"
      >
        {% for variant in product.variants %}
          <button
            class="opt {% if variant.id == current_variant.id %}selected{% endif %}"
            data-variant-id="{{ variant.id }}"
            data-price="{{ variant.price }}"
          >
            <div>
              <div class="opt-name">
                {{ variant.title }}
              </div>

              <div class="opt-price">
                {{ variant.price | money }}
              </div>
            </div>
          </button>
        {% endfor %}
      </div>
      <div
        class="price-block"
      >
        <div
          class="price-now"
          id="priceNow"
        >
          {{ current_variant.price | money }}
        </div>
        <div
          class="price-meta"
        >
          Paid at checkout
        </div>
        <div
          class="price-fine"
        >
          Less than $3 a day over a 2-year lifespan
        </div>
        <div
          class="price-link"
        >
          <a
            href="mailto:hello@reviveteeth.com?subject=Revive%20Veneers%20%E2%80%94%20Split%20payment%20request"
            >Need to split into 3 payments? Contact us →
          </a>
        </div>
      </div>
      <div
        class="stock"
      >
        <span
          class="pulse"
        >
        </span>
        In stock · Ships your impression kit within 48 hours
      </div>

      {% comment %}
        SHOPIFY
        DEVELOPER
        NOTE:
        This
        button
        must
        be
        wired
        to
        push
        the
        selected
        variant
        ID
        to
        the
        Shopify
        cart.
        The
        currently
        selected
        configuration
        is
        tracked
        via
        the
        `current`
        variable
        in
        the
        JavaScript
        (values:"upper"
        ,"lower"
        ,
        or"both"
        ).
        Map
        each
        value
        to
        its
        corresponding
        Shopify
        variant
        ID:
        upper
        →
        $1,
        497
        variant,
        lower
        →
        $1,
        497
        variant,
        both
        →
        $1,
        997
        variant.
        The
        `bumpCart`
        function
        currently
        only
        updates
        the
        cart
        count
        display
        —
        replace
        it
        with
        actual
        Shopify
        cart
        logic.
      {% endcomment %}
      <button
        class="cta"
        id="cta"
        data-variant-id="{{ current_variant.id }}"
      >
        {{ section.settings.button_text }}

        —

        <span id="ctaPrice">
          {{ current_variant.price | money }}
        </span>
      </button>
      <div class="guarantee-pill">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
              d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z">
              </path>
                  <path
                      d="M8.5 12.5l2.5 2.5L16 10">
                      </path>
        </svg>
        <div>
          <div
            class="gp-l1"
          >
            30-Day Money-Back Guarantee
          </div>
          <div
            class="gp-l2"
          >
            Free remakes · Full refund if it isn't right
          </div>
        </div>
      </div>
      <div
        class="pay-row"
        aria-label="Accepted payment methods"
      >
        <!--
          PLACEHOLDER: Replace these text pills with real payment provider logos (SVG) before launch: Visa, Mastercard, Amex, Apple Pay.
        -->
        <span
          class="pay-pill"
          >VISA
        </span>
        <span
          class="pay-pill"
          >Mastercard
        </span>
        <span
          class="pay-pill"
          >AMEX
        </span>
        <span
          class="pay-pill"
          >Apple Pay
        </span>
      </div>
      <div
        class="cred-row"
      >
        <span
          class="cred"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect
                x="4"
                y="11"
                width="16"
                height="10"
                rx="2">
                </rect>
                    <path
                        d="M8 11V7a4 4 0 0 1 8 0v4">
                        </path>
          </svg>
          Secure SSL checkout
        </span>
        <span
          class="cred"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle
                cx="12"
                cy="8"
                r="4">
                </circle>
                    <path
                        d="M4 21c0-4 4-6 8-6s8 2 8 6">
                        </path>
          </svg>
          Dentist-designed
        </span>
        <span
          class="cred"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
                d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z">
                </path>
          </svg>
          30-day money-back guarantee
        </span>
      </div>
    </div>
  </div>
</section>

<script>

document.addEventListener("DOMContentLoaded",()=>{


function formatMoney(cents) {
  return "$" + (cents / 100).toLocaleString("en-US");
}

const thumbs =
document.querySelectorAll(".thumb");

const galImg =
document.getElementById("galImg");

thumbs.forEach(btn=>{

btn.addEventListener("click",()=>{

thumbs.forEach(x=>
x.classList.remove("active"));

btn.classList.add("active");

galImg.src =
btn.dataset.image;

});

});

const options =
document.querySelectorAll(".opt");

const priceNow =
document.getElementById("priceNow");

const ctaPrice =
document.getElementById("ctaPrice");

const cta =
document.getElementById("cta");

options.forEach(option=>{

option.addEventListener("click",()=>{

options.forEach(btn=>
btn.classList.remove("selected"));

option.classList.add("selected");

const price =
parseInt(
option.dataset.price
);

priceNow.textContent = formatMoney(price);
ctaPrice.textContent = formatMoney(price);

cta.dataset.variantId =
option.dataset.variantId;

});

});

cta.addEventListener("click",async()=>{

await fetch("/cart/add.js",{

method:"POST",

headers:{
"Content-Type":
"application/json"
},

body:JSON.stringify({

id:cta.dataset.variantId,

quantity:1

})

});

window.location.href =
"/checkout";

});

});

</script>

{% schema %}
{
  "name": "Hero Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Designed by Dr. Brandon Turley, DDS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The snap-on veneer your dentist would actually recommend."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Custom-fitted to your impressions. Designed against a 7-point clinical protocol."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add To Cart"
    }
  ],
  "presets": [
    {
      "name": "Hero Product"
    }
  ]
}
{% endschema %}
