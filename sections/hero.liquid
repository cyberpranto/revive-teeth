<!-- < !--==============HERO============== -->
<section class="hero"style="padding-top:48px">
  <div class="wrap hero-grid">
    <!-- < !-- Gallery -->
    <div class="gallery">
      <div class="gallery-main"id="galMain">
        <img
          id="galImg"
          src="{{ 'gallery-img-1.png' | asset_url }}"
          alt="Revive Veneers · front view"
          width="100"
          height="100"
        >
      </div>
      <div class="thumbs"id="thumbs">
        <button
          class="thumb active"
          data-rid="veneerFront"
          data-alt="Front view"
          aria-label="Front view"
        >
          <img src="{{ 'gallery-img-1.png' | asset_url }}"alt=""width="100"height="100">
        </button>
        <button
          class="thumb"
          data-rid="veneer34"
          data-alt="Three-quarter angle"
          aria-label="Three-quarter angle"
        >
          <img src="{{ 'galery-img-2.png' | asset_url }}"alt=""width="100"height="100">
        </button>
        <button
          class="thumb"
          data-rid="veneerTopdown"
          data-alt="Top-down arch"
          aria-label="Top-down arch"
        >
          <img src="{{ 'galery-img-3.png' | asset_url }}"alt=""width="100"height="100">
        </button>
        <button
          class="thumb"
          data-rid="veneerCase"
          data-alt="In protective case"
          aria-label="In protective case"
        >
          <img src="{{ 'galery-img-4.png' | asset_url }}"alt=""width="100"height="100">
        </button>
      </div>
    </div>
    <div class="buybox">
      <div class="eyebrow-sm">Designed by Dr. Brandon Turley, DDS</div>
      <div class="cred-strip">
        DDS
        <span class="dot">· </span>
        12+years clinical practice
        <span class="dot">· </span>
        7-Point design protocol
        <span class="dot">· </span>
        Designed in the USA
      </div>
      <h1 class="display">The snap-on veneer your dentist would actually recommend.</h1>
      <p class="lead">
        Custom-fitted to your impressions. Designed against a 7-point clinical protocol. For people who want a refined
        smile without the $15, 000 dental chair commitment.
      </p>
      <hr>
      <div class="config-label">
        Configuration
        <span class="req">· Choose one </span>
      </div>
      <div class="config"id="config"role="radiogroup"aria-label="Configuration">
        <button
          class="opt"
          role="radio"
          aria-checked="false"
          data-key="upper"
          data-price="1497"
        >
          <svg
            class="arch-icon"
            viewBox="0 0 60 32"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 22 C 8 6, 52 6, 56 22">
            </path>
            <path d="M12 12 L12 19 M20 9 L20 18 M30 7.5 L30 17.5 M40 9 L40 18 M48 12 L48 19"
                stroke-width="1.6">
            </path>
          </svg>
          <div>
            <div class="opt-name">Upper Arch</div>
            <div class="opt-price">$1, 497</div>
          </div>
        </button>
        <button
          class="opt"
          role="radio"
          aria-checked="false"
          data-key="lower"
          data-price="1497"
        >
          <svg
            class="arch-icon"
            viewBox="0 0 60 32"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 10 C 8 26, 52 26, 56 10">
            </path>
            <path d="M12 20 L12 13 M20 23 L20 14 M30 24.5 L30 14.5 M40 23 L40 14 M48 20 L48 13"
                stroke-width="1.6">
            </path>
          </svg>
          <div>
            <div class="opt-name">Lower Arch</div>
            <div class="opt-price">$1, 497</div>
          </div>
        </button>
        <button
          class="opt selected"
          role="radio"
          aria-checked="true"
          data-key="both"
          data-price="1997"
        >
          <span class="badge">Most Chosen </span>
          <svg
            class="arch-icon"
            viewBox="0 0 60 40"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 16 C 8 0, 52 0, 56 16">
                </path>
                    <path d="M4 24 C 8 40, 52 40, 56 24">
                        </path>
          </svg>
          <div>
            <div class="opt-name">Both Arches</div>
            <div class="opt-price">$1, 997</div>
            <div
              class="save"
            >
              Save $997 vs. buying separately
            </div>
          </div>
        </button>
      </div>
      <div
        class="price-block"
      >
        <div
          class="price-now"
          id="priceNow"
        >
          $1, 997
        </div>
        <div
          class="price-meta"
        >
          Paid at checkout
        </div>
        <div
          class="price-fine"
        >
          Less than $3 a day over a 2-year lifespan
        </div>
        <div
          class="price-link"
        >
          <a
            href="mailto:hello@reviveteeth.com?subject=Revive%20Veneers%20%E2%80%94%20Split%20payment%20request"
            >Need to split into 3 payments? Contact us →
          </a>
        </div>
      </div>
      <div
        class="stock"
      >
        <span
          class="pulse"
        >
        </span>
        In stock · Ships your impression kit within 48 hours
      </div>

      {% comment %}
        SHOPIFY
        DEVELOPER
        NOTE:
        This
        button
        must
        be
        wired
        to
        push
        the
        selected
        variant
        ID
        to
        the
        Shopify
        cart.
        The
        currently
        selected
        configuration
        is
        tracked
        via
        the
        `current`
        variable
        in
        the
        JavaScript
        (values:"upper"
        ,"lower"
        ,
        or"both"
        ).
        Map
        each
        value
        to
        its
        corresponding
        Shopify
        variant
        ID:
        upper
        →
        $1,
        497
        variant,
        lower
        →
        $1,
        497
        variant,
        both
        →
        $1,
        997
        variant.
        The
        `bumpCart`
        function
        currently
        only
        updates
        the
        cart
        count
        display
        —
        replace
        it
        with
        actual
        Shopify
        cart
        logic.
      {% endcomment %}
      <button
        class="cta"
        id="cta"
      >
        Add to Cart —
        <span
          id="ctaPrice"
          >$1, 997
        </span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
              d="M5 12h14M13 6l6 6-6 6">
              </path>
        </svg>
      </button>
      <div class="guarantee-pill">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
              d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z">
              </path>
                  <path
                      d="M8.5 12.5l2.5 2.5L16 10">
                      </path>
        </svg>
        <div>
          <div
            class="gp-l1"
          >
            30-Day Money-Back Guarantee
          </div>
          <div
            class="gp-l2"
          >
            Free remakes · Full refund if it isn't right
          </div>
        </div>
      </div>
      <div
        class="pay-row"
        aria-label="Accepted payment methods"
      >
        <!--
          PLACEHOLDER: Replace these text pills with real payment provider logos (SVG) before launch: Visa, Mastercard, Amex, Apple Pay.
        -->
        <span
          class="pay-pill"
          >VISA
        </span>
        <span
          class="pay-pill"
          >Mastercard
        </span>
        <span
          class="pay-pill"
          >AMEX
        </span>
        <span
          class="pay-pill"
          >Apple Pay
        </span>
      </div>
      <div
        class="cred-row"
      >
        <span
          class="cred"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect
                x="4"
                y="11"
                width="16"
                height="10"
                rx="2">
                </rect>
                    <path
                        d="M8 11V7a4 4 0 0 1 8 0v4">
                        </path>
          </svg>
          Secure SSL checkout
        </span>
        <span
          class="cred"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle
                cx="12"
                cy="8"
                r="4">
                </circle>
                    <path
                        d="M4 21c0-4 4-6 8-6s8 2 8 6">
                        </path>
          </svg>
          Dentist-designed
        </span>
        <span
          class="cred"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
                d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z">
                </path>
          </svg>
          30-day money-back guarantee
        </span>
      </div>
    </div>
  </div>
</section>


{% schema %}
{
 "name":"Hero",
 "settings": []
}
{% endschema %}