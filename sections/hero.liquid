{% assign product = section.settings.product %}

{% if product == blank %}
  <p>Select a product in theme customizer.</p>
  {% break %}
{% endif %}

{% assign current_variant = product.selected_or_first_available_variant %}

<section class="hero" style="padding-top:48px">
  <div class="wrap hero-grid">
    <!-- < !-- Gallery -->
    <div class="gallery">
      <div class="gallery-main">
        <img
          id="galImg"
          src="{{ product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.title }}"
          width="1200"
          height="1200"
        >
      </div>

      <div class="thumbs">
        {% for image in product.images %}
          <button
            class="thumb {% if forloop.first %}active{% endif %}"
            data-image="{{ image | image_url: width: 1200 }}"
          >
            <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt }}" width="200" height="200">
          </button>
        {% endfor %}
      </div>
    </div>
    <div class="buybox">
      <div class="eyebrow-sm">
        {{ section.settings.eyebrow }}
      </div>
      <div class="cred-strip">
        {% for block in section.blocks %}
          {% if block.type == 'cred_strip' %}
            {{ block.settings.text }}

            {% unless forloop.last %}
              <span class="dot">·</span>
            {% endunless %}
          {% endif %}
        {% endfor %}
      </div>
      <h1 class="display">
        {{ section.settings.heading }}
      </h1>
      <p class="lead">
        {{ section.settings.description }}
      </p>
      <hr>
      <div class="config-label">
        {{ section.settings.config_title }}
        <span class="req">· Choose one </span>
      </div>
      <div class="config" id="config">
        {% for variant in product.variants %}
          <button
            class="opt {% if forloop.first %}selected{% endif %}"
            data-variant-id="{{ variant.id }}"
            data-price="{{ variant.price }}"
          >
            {% case variant.title %}
              {% when 'Upper Arch' %}
                <!-- Upper SVG -->
                <svg
                  class="arch-icon"
                  viewBox="0 0 60 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 22 C 8 6, 52 6, 56 22">
                  </path>
                  <path d="M12 12 L12 19 M20 9 L20 18 M30 7.5 L30 17.5 M40 9 L40 18 M48 12 L48 19" stroke-width="1.6">
                  </path>
                </svg>

              {% when 'Lower Arch' %}
                <!-- Lower SVG -->

                <svg
                  class="arch-icon"
                  viewBox="0 0 60 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 10 C 8 26, 52 26, 56 10">
                  </path>
                  <path d="M12 20 L12 13 M20 23 L20 14 M30 24.5 L30 14.5 M40 23 L40 14 M48 20 L48 13" stroke-width="1.6">
                  </path>
                </svg>

              {% when 'Both Arches' %}
                <span class="badge">Most Chosen</span>

                <!-- Both SVG -->

                <svg
                  class="arch-icon"
                  viewBox="0 0 60 40"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 16 C 8 0, 52 0, 56 16">
                  </path>
                  <path d="M4 24 C 8 40, 52 40, 56 24">
                  </path>
                </svg>
            {% endcase %}

            <div>
              <div class="opt-name">
                {{ variant.title }}
              </div>

              <div class="opt-price">
                {{ variant.price | money_without_trailing_zeros }}
              </div>
              {% case variant.title %}
                {% when 'Both Arches' %}
                  <div
                    class="save"
                  >
                    Save $997 vs. buying separately
                  </div>
              {% endcase %}
            </div>
          </button>
        {% endfor %}
      </div>
      <div class="price-block">
        <div class="price-now" id="priceNow">
          {{ current_variant.price | money_without_trailing_zeros }}
        </div>
        <div class="price-meta">Paid at checkout</div>
        <div class="price-fine">Less than $3 a day over a 2-year lifespan</div>
        <div class="price-link">
          {% comment %}
            <a href="mailto:hello@reviveteeth.com?subject=Revive%20Veneers%20%E2%80%94%20Split%20payment%20request"
              >Need to split into 3 payments? Contact us →
            </a>
          {% endcomment %}
          <a href="{{ section.settings.payment_link }}">
            {{ section.settings.payment_text }}
          </a>
        </div>
      </div>
      <div class="stock">
        <span class="pulse"> </span>
        {{ section.settings.stock_text }}
      </div>

      {% comment %}
        SHOPIFY
        DEVELOPER
        NOTE:
        This
        button
        must
        be
        wired
        to
        push
        the
        selected
        variant
        ID
        to
        the
        Shopify
        cart.
        The
        currently
        selected
        configuration
        is
        tracked
        via
        the
        `current`
        variable
        in
        the
        JavaScript
        (values:"upper"
        ,"lower"
        ,
        or"both"
        ).
        Map
        each
        value
        to
        its
        corresponding
        Shopify
        variant
        ID:
        upper
        →
        $1,
        497
        variant,
        lower
        →
        $1,
        497
        variant,
        both
        →
        $1,
        997
        variant.
        The
        `bumpCart`
        function
        currently
        only
        updates
        the
        cart
        count
        display
        —
        replace
        it
        with
        actual
        Shopify
        cart
        logic.
      {% endcomment %}
      <button class="cta" id="cta" data-variant-id="{{ current_variant.id }}">
        {{ section.settings.button_text }}

        —

        <span id="ctaPrice">
          {{ current_variant.price | money_without_trailing_zeros }}
        </span>
      </button>
      <div class="guarantee-pill">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path>
          <path d="M8.5 12.5l2.5 2.5L16 10"></path>
        </svg>

        <div>
          <div class="gp-l1">
            {{ section.settings.guarantee_title }}
          </div>

          <div class="gp-l2">
            {{ section.settings.guarantee_text }}
          </div>
        </div>
      </div>

      <div class="pay-row" aria-label="Accepted payment methods">
        {% for block in section.blocks %}
          {% if block.type == 'payment' %}
            <span class="pay-pill">
              {{ block.settings.label }}
            </span>
          {% endif %}
        {% endfor %}
      </div>

      <div class="cred-row">
        {% for block in section.blocks %}
          {% if block.type == 'credibility' %}
            <span class="cred">
              {% if block.settings.icon != blank %}
                {{ block.settings.icon }}
              {% endif %}
              {{ block.settings.text }}
            </span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    function formatMoney(cents) {
      return '$' + (cents / 100).toLocaleString('en-US');
    }

    /* =========================
      GALLERY
  ========================= */

    const thumbs = document.querySelectorAll('.thumb');
    const galImg = document.getElementById('galImg');

    thumbs.forEach((btn) => {
      btn.addEventListener('click', () => {
        thumbs.forEach((x) => x.classList.remove('active'));

        btn.classList.add('active');

        if (btn.dataset.image) {
          galImg.src = btn.dataset.image;
        }
      });
    });

    /* =========================
      VARIANTS
  ========================= */

    const options = document.querySelectorAll('.opt');
    const priceNow = document.getElementById('priceNow');
    const ctaPrice = document.getElementById('ctaPrice');
    const cta = document.getElementById('cta');

    function selectVariant(option) {
      options.forEach((btn) => btn.classList.remove('selected'));

      option.classList.add('selected');

      const price = parseInt(option.dataset.price, 10);

      priceNow.textContent = formatMoney(price);
      ctaPrice.textContent = formatMoney(price);

      cta.dataset.variantId = option.dataset.variantId;
    }

    options.forEach((option) => {
      option.addEventListener('click', () => {
        selectVariant(option);
      });
    });

    /* =========================
      DEFAULT SELECT
  ========================= */

    const defaultOption = document.querySelector('.opt.selected') || options[0];

    if (defaultOption) {
      selectVariant(defaultOption);
    }

    /* =========================
      ADD TO CART
  ========================= */

    cta.addEventListener('click', async () => {
      const variantId = cta.dataset.variantId;

      if (!variantId) {
        alert('Please select a variant');
        return;
      }

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: Number(variantId),
            quantity: 1,
          }),
        });

        if (!response.ok) {
          throw new Error('Add to cart failed');
        }

        window.location.href = '/checkout';
      } catch (error) {
        console.error(error);
        alert('Unable to add product to cart');
      }
    });
  });
</script>
{% schema %}
{
  "name": "Hero Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Designed by Dr. Brandon Turley, DDS"
