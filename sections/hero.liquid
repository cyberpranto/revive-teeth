      "label": "Heading",
      "default": "The snap-on veneer your dentist would actually recommend."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Custom-fitted to your impressions. Designed against a 7-point clinical protocol."
    },

    {
      "type": "text",
      "id": "config_title",
      "label": "Configuration Title",
      "default": "Configuration"
    },
    {
      "type": "url",
      "id": "payment_link",
      "label": "Payment Link"
    },
    {
      "type": "text",
      "id": "payment_text",
      "label": "Payment Link Text",
      "default": "Need to split into 3 payments? Contact us →"
    },
    {
      "type": "text",
      "id": "stock_text",
      "label": "Stock Text",
      "default": "In stock · Ships your impression kit within 48 hours"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add To Cart"
    },
    {
      "type": "text",
      "id": "guarantee_title",
      "label": "Guarantee Title",
      "default": "30-Day Money-Back Guarantee"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Description",
      "default": "Free remakes · Full refund if it isn't right"
    }
  ],
  "blocks": [
    {
      "type": "cred_strip",
      "name": "Credibility Strip",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "payment",
      "name": "Payment Method",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Payment Name",
          "default": "VISA"
        }
      ]
    },
    {
      "type": "credibility",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "liquid",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        {
          "type": "payment",
          "settings": {
            "label": "VISA"
          }
        },
        {
          "type": "payment",
          "settings": {
            "label": "Mastercard"
          }
        },
        {
          "type": "payment",
          "settings": {
            "label": "AMEX"
          }
        },
        {
          "type": "payment",
          "settings": {
            "label": "Apple Pay"
          }
        },

        {
          "type": "credibility",
          "settings": {
            "text": "Secure SSL Checkout"
          }
        },
        {
          "type": "credibility",
          "settings": {
            "text": "Dentist-designed"
          }
        },
        {
          "type": "credibility",
          "settings": {
            "text": "30-day money-back guarantee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
