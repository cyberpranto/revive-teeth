<section>
  <div class="wrap founder-grid">
    <div>
      <div class="eyebrow">
        {{ section.settings.eyebrow }}
      </div>

      <p class="pullquote">
        {{ section.settings.quote }}
      </p>

      <div class="founder-body">
        {{ section.settings.body }}
      </div>

      {% if section.settings.signature_image != blank %}
        {{
          section.settings.signature_image
          | image_url: width: 600
          | image_tag:
            class: 'sig-img',
            loading: 'lazy',
            alt: section.settings.founder_name
        }}
      {% else %}
        <img
          src="{{ 'signature.png' | asset_url }}"
          alt="{{ section.settings.founder_name }}"
          class="sig-img"
          loading="lazy"
          width="100"
          height="100"
        >
      {% endif %}

      <div class="sig-sub">
        {{ section.settings.signature_text }}
      </div>
    </div>

    <div class="portrait">
      {% if section.settings.founder_image != blank %}
        {{
          section.settings.founder_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            alt: section.settings.founder_name
        }}
      {% else %}
        <img
          src="{{ 'founder-image.jfif' | asset_url }}"
          alt="{{ section.settings.founder_name }}"
          loading="lazy"
          width="100"
          height="100"
        >
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder Note",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A note from Dr. Turley"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "\"I built Revive Teeth for patients I've seen in my practice for years — people who want their smile to look right in photos again, but aren't ready to commit to $15,000 and permanent enamel removal. That choice should exist.\""
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Content",
      "default": "<p>Most snap-on veneers are cheaply manufactured plastic, shipped from factories by companies that don't have a practicing dentist on their team.</p><p>That's the gap Revive Veneers fills. Every case is designed against my 7-point smile design protocol.</p><p>My name is on this because I built it. Welcome.</p>"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signature Image"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder Name",
      "default": "Dr. Brandon Turley"
    },
    {
      "type": "text",
      "id": "signature_text",
      "label": "Signature Subtitle",
      "default": "Doctor of Dental Surgery · Founder, Revive Teeth"
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder Portrait"
    }
  ],
  "presets": [
    {
      "name": "Founder Note"
    }
  ]
}
{% endschema %}