<!-- ============== FOOTER ============== -->
<footer id="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot foot-brand">
        <div class="brand" style="margin-bottom:10px">
          {% if section.settings.logo %}
            <img
              src="{{ section.settings.logo | image_url }}"
              alt="{{ shop.name }}"
              width="200"
              height="80">
          {% endif %}
        </div>

        <p class="tag">
          {{ section.settings.tagline }}
        </p>
      </div>

      <div class="foot">
        <h5>Customer Support</h5>

        <ul>
          {% for block in section.blocks %}
            {% if block.type == 'support_link' %}
              <li>
                <a href="{{ block.settings.url }}">
                  {{ block.settings.title }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="foot">
        <h5>Payment</h5>

        <div class="foot-tagline-small">
          {{ section.settings.payment_text }}
        </div>
      </div>

      <div class="foot">
        <h5>
          {{ section.settings.newsletter_heading }}
        </h5>

        {{ section.settings.newsletter_form }}

        <div class="foot-tagline-small">
          {{ section.settings.newsletter_note }}
        </div>
      </div>
    </div>

    <div class="foot-bottom">
      <div>
        {{ section.settings.copyright }}
      </div>

      <div class="legal">
        {% for block in section.blocks %}
          {% if block.type == 'legal_link' %}
            <a href="{{ block.settings.url }}">
              {{ block.settings.title }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="foot-disclaimer">
      {{ section.settings.disclaimer }}
    </div>
  </div>
</footer>

{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },

      {
        "type": "text",
        "id": "tagline",
        "label": "Tagline"
      },

      {
        "type": "richtext",
        "id": "payment_text",
        "label": "Payment Text"
      },

      {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Newsletter Heading"
      }, {
        "type": "liquid",
        "id": "newsletter_form",
        "label": "Newsletter Form"
      }, {
        "type": "text",
        "id": "newsletter_note",
        "label": "Newsletter Note"
      }, {
        "type": "text",
        "id": "copyright",
        "label": "Copyright"
      }, {
        "type": "richtext",
        "id": "disclaimer",
        "label": "Disclaimer"
      }

    ],

    "blocks": [
      {
        "type": "support_link",
        "name": "Support Link",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          }, {
