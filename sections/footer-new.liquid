<!-- ============== FOOTER ============== -->
<footer id="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot foot-brand">
        <div class="brand" style="margin-bottom:10px">
          {% if section.settings.logo %}
            <img
              src="{{ section.settings.logo | image_url }}"
              alt="{{ shop.name }}"
              width="200"
              height="80"
            >
          {% endif %}
        </div>

        <p class="tag">
          {{ section.settings.tagline }}
        </p>
      </div>

      <div class="foot">
        <h5>Customer Support</h5>

        <ul>
          {% for block in section.blocks %}
            {% if block.type == 'support_link' %}
              <li>
                <a href="{{ block.settings.url }}">
                  {{ block.settings.title }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="foot">
        <h5>Payment</h5>

        <div class="foot-tagline-small">
          {{ section.settings.payment_text }}
        </div>
      </div>

      <div class="foot">
        <h5>
          {{ section.settings.newsletter_heading }}
        </h5>

        <form class="sub-input" id="newsletter-form">
          <input
            type="email"
            id="newsletter-email"
            placeholder="{{ section.settings.placeholder }}"
            required
          >

          <button
            type="submit"
            id="newsletter-submit"
          >
            {{ section.settings.button_text }}
          </button>
        </form>

        <div
          id="newsletter-message"
          class="newsletter-message"
        ></div>

        <div class="foot-tagline-small">
          {{ section.settings.newsletter_note }}
        </div>
      </div>
    </div>

    <div class="foot-bottom">
      <div>
        {{ section.settings.copyright }}
      </div>

      <div class="legal">
        {% for block in section.blocks %}
          {% if block.type == 'legal_link' %}
            <a href="{{ block.settings.url }}">
              {{ block.settings.title }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="foot-disclaimer">
      {{ section.settings.disclaimer }}
    </div>
  </div>
</footer>


<script>

document.addEventListener('DOMContentLoaded', () => {

  const form =
    document.getElementById('newsletter-form');

  if (!form) return;

  form.addEventListener('submit', async (e) => {

    e.preventDefault();

    const email =
      document.getElementById('newsletter-email').value;

    const button =
      document.getElementById('newsletter-submit');

    const message =
      document.getElementById('newsletter-message');

    button.disabled = true;
    button.textContent = 'Subscribing...';

    try {

      await fetch(
        'https://manage.kmail-lists.com/ajax/subscriptions/subscribe',
        {
          method: 'POST',
          headers: {
            'Content-Type':
              'application/x-www-form-urlencoded'
          },
          body: new URLSearchParams({
            g: '{{ section.settings.klaviyo_list_id }}',
            email: email
          })
        }
      );

      message.textContent =
        'Thanks for subscribing!';

      form.reset();

      button.textContent =
        'Subscribed ✓';

    } catch(error) {

      console.error(error);

      message.textContent =
        'Something went wrong.';

      button.textContent =
        '{{ section.settings.button_text }}';

    }

    button.disabled = false;

  });

});

</script>

