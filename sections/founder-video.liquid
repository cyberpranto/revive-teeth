<section class="cream fv-section">
  <div class="wrap">

    <div class="fv-head">
      <div class="eyebrow">
        {{ section.settings.eyebrow }}
      </div>

      <h2 class="display" style="margin-top:14px">
        {{ section.settings.heading }}
      </h2>

      <p class="sub">
        {{ section.settings.description }}
      </p>
    </div>

    <div class="fv-frame">

      {% if section.settings.video != blank %}

        {{
          section.settings.video
          | video_tag:
            autoplay: false,
            loop: false,
            controls: true,
            muted: false
        }}

      {% elsif section.settings.video_url != blank %}

        <iframe
        src="{{ section.settings.video_url }}"
        allowfullscreen
        loading="lazy">
      </iframe>

      {% else %}

        <div class="video-placeholder">
          Upload a video
        </div>

      {% endif %}

    </div>

    <div class="fv-cap">
      {{ section.settings.caption }}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Founder Video",
  "class": "founder-video",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why we built this"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "I'm Dr. Brandon Turley. I want to tell you something most people in my profession won't."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A 90-second note from the founder. Why traditional veneers fail most people, and what to do instead."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify Hosted Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube / Vimeo URL",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Dr. Brandon Turley, DDS · Practicing cosmetic dentist · 90 seconds"
    }
  ],
  "presets": [
    {
      "name": "Founder Video"
    }
  ]
}
{% endschema %}