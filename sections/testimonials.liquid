<section class="cream {{ section.settings.section_id }}" id="reviews">
  <div class="wrap">
    <div class="sect-head">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>

      <h2 class="display" style="margin-top:14px">
        {{ section.settings.heading }}
      </h2>

      <p class="sub">
        {{ section.settings.description }}
      </p>
    </div>

    <div class="tests-grid">
      {% for block in section.blocks %}
        <article class="test-card" {{ block.shopify_attributes }}>
          <div class="test-thumb">

            {% if block.settings.thumbnail != blank %}
              {{
                block.settings.thumbnail
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'ph'
              }}
            {% else %}
              <div class="ph"></div>
            {% endif %}

            {% if block.settings.tag != blank %}
              <span class="tag">
                {{ block.settings.tag }}
              </span>
            {% endif %}

            <span class="rule"></span>

            <div class="play">
              <button
                class="play-btn"
                aria-label="Play"
                {% if block.settings.video_url != blank %}
                  data-video="{{ block.settings.video_url }}"
                {% endif %}
              >
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6 4l14 8-14 8z"></path>
                </svg>
              </button>
            </div>

            {% if block.settings.quote != blank %}
              <div class="quote">
                {{ block.settings.quote }}
              </div>
            {% endif %}
          </div>

          <div class="test-meta">
            {{ block.settings.meta }}
          </div>
        </article>
      {% endfor %}
    </div>

    <p class="tests-note">
      {{ section.settings.note }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Customer Stories",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "default": "reviews"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real stories arriving soon."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We're documenting first-impression reactions from our launch customers. No scripts, no incentives. Order today and you could be one of the first stories we feature here."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Bottom Note",
      "default": "Video testimonials from our launch customers will appear here. We're recording real first-impression reactions. No scripts, no incentives."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Confidence"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I didn't realize how much I was hiding it."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Customer Info",
          "default": "Customer Name, City · Month YYYY"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Stories",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}