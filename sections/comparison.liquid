
<section>
  <div
    class=" wrap "
  >
    <div
      class=" sect-head "
    >
      <div
        class=" eyebrow "
      >
        What makes it different
      </div>
      <h2
        class=" display "
        style=" margin-top:14px "
      >
        The cheap snap-on you almost bought, next to the one you should.
      </h2>
      <p
        class=" sub "
      >
        Side by side, you can see the difference between cheaply manufactured plastic and a clinically designed
        appliance built to a 7-point protocol.
      </p>
    </div>
    <div
      class=" cmp-grid "
    >
      <div
        class=" cmp-card "
      >
        <div
          class=" cmp-image "
        >
          <!--
            PLACEHOLDER: Comparison illustration of generic mass-market snap-on veneer. Must NOT show branded competitor product. Stylized geometric illustration of a generic, uniform-thickness snap-on with visible gumline gap.
          -->
          <svg
            class=" ph "
            viewBox=" 0 0 400 300 "
            preserveAspectRatio=" xMidYMid slice "
            aria-hidden=" true "
          >
            <rect
                width=" 400 "
                height=" 300 "
                fill=" #ECEEF2 ">
                </rect>
                    <g
                        transform=" translate(200 160) ">
                        <!-- generic uniform shape -->
                        <path
                            d=" M -120 0 Q -120 -50 0 -50 Q 120 -50 120 0 L 110 30 L -110 30 Z "
                            fill=" #C9CDD7 ">
                            </path>
                                <!-- uniform teeth blocks (no individuation) -->
                                <g
                                    fill=" #fff ">
                                    <rect
                                        x=" -100 "
                                        y=" -40 "
                                        width=" 22 "
                                        height=" 60 "
                                        rx=" 3 ">
                                        </rect>
                                            <rect
                                                x=" -72 "
                                                y=" -40 "
                                                width=" 22 "
                                                height=" 60 "
                                                rx=" 3 ">
                                                </rect>
                                                    <rect
                                                        x=" -44 "
                                                        y=" -40 "
                                                        width=" 22 "
                                                        height=" 60 "
                                                        rx=" 3 ">
                                                        </rect>
                                                            <rect
                                                                x=" -16 "
                                                                y=" -40 "
                                                                width=" 22 "
                                                                height=" 60 "
                                                                rx=" 3 ">
                                                                </rect>
                                                                    <rect
                                                                        x=" 12 "
                                                                        y=" -40 "
                                                                        width=" 22 "
                                                                        height=" 60 "
                                                                        rx=" 3 ">
                                                                        </rect>
                                                                            <rect
                                                                                x=" 40 "
                                                                                y=" -40 "
                                                                                width=" 22 "
                                                                                height=" 60 "
                                                                                rx=" 3 ">
                                                                                </rect>
                                                                                    <rect
                                                                                        x=" 68 "
                                                                                        y=" -40 "
                                                                                        width=" 22 "
                                                                                        height=" 60 "
                                                                                        rx=" 3 ">
                                                                                        </rect>
                                                                                            </g>
                                                                                                <!-- gap line indicator -->
                                                                                                <path
                                                                                                    d=" M -120 -55 L 120 -55 "
                                                                                                    stroke=" #B85322 "
                                                                                                    stroke-dasharray=" 4 4 "
                                                                                                    stroke-width=" 1.5 ">
                                                                                                    </path>
                                                                                                        </g>
          </svg>
          <span
            class=" ph-label "
            >[ generic snap-on · illustration ]
          </span>
        </div>
        <div
          class=" cmp-body "
        >
          <div
            class=" cmp-tag "
          >
            What you find elsewhere
          </div>
