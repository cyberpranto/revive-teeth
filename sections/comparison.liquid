<section>
  <div class="wrap">
    <div class="sect-head">
      <div class="eyebrow">
        {{ section.settings.eyebrow }}
      </div>

      <h2 class="display" style="margin-top:14px">
        {{ section.settings.heading }}
      </h2>

      <p class="sub">
        {{ section.settings.subheading }}
      </p>
    </div>

    <div class="cmp-grid">
      {% for block in section.blocks %}
        <div class="cmp-card {% if block.settings.highlight %}win{% endif %}" {{ block.shopify_attributes }}>
          <div class="cmp-image">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', alt: block.settings.title
              }}
            {% else %}
              {% if block.settings.highlight %}
                <img
                  src="{{ 'comparison-image-1.png' | asset_url }}"
                  alt="{{ block.settings.title }}"
                  width="100"
                  height="100"
                >
              {% else %}
                <svg
                  class="ph"
                  viewBox="0 0 400 300"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                    <rect
                      width="400"
                      height="300"
                      fill="#ECEEF2"></rect>
                    <g transform="translate(200 160)">
                    <!-- generic uniform shape -->
                    <path d="M -120 0 Q -120 -50 0 -50 Q 120 -50 120 0 L 110 30 L -110 30 Z" fill="#C9CDD7"></path>
                    <!-- uniform teeth blocks (no individuation) -->
                    <g fill="#fff">
                      <rect
                        x="-100"
                        y="-40"
                        width="22"
                        height="60"
                        rx="3"></rect>
                      <rect
                        x="-72"
                        y="-40"
                        width="22"
                        height="60"
                        rx="3"></rect>
                      <rect
                        x="-44"
                        y="-40"
                        width="22"
                        height="60"
                        rx="3"></rect>
                      <rect
                        x="-16"
                        y="-40"
                        width="22"
                        height="60"
                        rx="3"></rect>
                      <rect
                        x="12"
                        y="-40"
                        width="22"
                        height="60"
                        rx="3"></rect>
                      <rect
                        x="40"
                        y="-40"
                        width="22"
                        height="60"
                        rx="3"></rect>
                      <rect
                        x="68"
                        y="-40"
                        width="22"
                        height="60"
                        rx="3"></rect>
                    </g>
                    <!-- gap line indicator -->
                    <path
                      d="M -120 -55 L 120 -55"
                      stroke="#B85322"
                      stroke-dasharray="4 4"
                      stroke-width="1.5"></path>
                  </g>
                </svg>
              {% endif %}
            {% endif %}
          </div>

          <div class="cmp-body">
            <div class="cmp-tag">
              {{ block.settings.tag }}
            </div>

            <h3>{{ block.settings.title }}</h3>

            <ul class="cmp-list">
              {% assign items = block.settings.items | newline_to_br | split: '<br />' %}

              {% for item in items %}
                {% if item != blank %}
                  <li>
                    {% if block.settings.highlight %}
                      <span class="ico c">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path
                              d="M5 12l5 5 9-11">
                              </path>
                        </svg>
                      </span>
                    {% else %}
                      <span class="ico x">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                        >
                          <path
                              d="M6 6l12 12M18 6L6 18">
                              </path>
                        </svg>
                      </span>
                    {% endif %}

                    {{ item }}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Comparison Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What makes it different"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The cheap snap-on you almost bought, next to the one you should."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Side by side, you can see the difference between cheaply manufactured plastic and a clinically designed appliance built to a 7-point protocol."
    }
  ],
  "blocks": [
    {
      "type": "comparison",
      "name": "Comparison Card",
      "limit": 2,
      "settings": [
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlighted Card"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "List Items (one per line)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Section",
      "blocks": [
        {
          "type": "comparison",
          "settings": {
            "tag": "What you find elsewhere",
            "title": "Generic plastic, one-size impression",
            "items": "One mold shape across all teeth\nVisible plastic gap at the gumline\nZero individual tooth shaping\nShips in 3 days because no one designs it"
          }
        },
        {
          "type": "comparison",
          "settings": {
            "highlight": true,
            "tag": "What you get from Revive",
            "title": "Custom-fitted, hand-finished, clinically designed",
            "items": "~0.5mm thickness, individually adjusted per tooth\nCustom gumline contour designed to your impressions\nIndividual proportions and translucent edges, tooth by tooth\n7 clinical design checkpoints, 14–21 days of design time per case"
          }
        }
      ]
    }
  ]
}
{% endschema %}
