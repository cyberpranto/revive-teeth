<div class="trust">
  <div class="wrap">
    <div class="trust-grid">

      {% for block in section.blocks %}

        <div class="tbadge" {{ block.shopify_attributes }}>

          {% case block.settings.icon %}

            {% when 'dentist' %}
              <!-- SVG 1 -->
              {% render 'dentist-icon' %}

            {% when 'moneyback' %}
              <!-- SVG 2 -->
              {% render 'moneyback-icon' %}


            {% when 'lifespan' %}
              <!-- SVG 3 -->
              {% render 'lifespan-icon' %}


            {% when 'bpa' %}
              <!-- SVG 4 -->
              {% render 'bpa-icon' %}


            {% when 'shipping' %}
              <!-- SVG 5 -->
              {% render 'shipping-icon' %}

            {% when 'remake' %}
              <!-- SVG 6 -->
              {% render 'remake-icon' %}

          {% endcase %}

          <div class="lbl">
            {{ block.settings.label }}
          </div>

        </div>

      {% endfor %}

    </div>
  </div>
</div>


{% schema %}
  {
    "name": "Trust Badges",
    "blocks": [
      {
        "type": "badge",
        "name": "Badge",
        "limit": 6,
        "settings": [
          {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "options": [
              {
                "value": "dentist",
                "label": "Dentist Designed"
              },
              {
                "value": "moneyback",
                "label": "Money Back"
              },
              {
                "value": "lifespan",
                "label": "Lifespan"
              },
              {
                "value": "bpa",
                "label": "BPA Free"
              }, {
                "value": "shipping",
                "label": "Free Shipping"
              }, {
                "value": "remake",
                "label": "Free Remakes"
              }
            ],
            "default": "dentist"
          }, {
            "type": "text",
            "id": "label",
            "label": "Label"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Trust Badges",
        "blocks": [
          {
            "type": "badge",
            "settings": {
              "icon": "dentist",
              "label": "Dentist-Designed"
            }
          },
          {
            "type": "badge",
            "settings": {
              "icon": "moneyback",
              "label": "30-Day Money-Back"
            }
          },
          {
            "type": "badge",
            "settings": {
              "icon": "lifespan",
              "label": "3–5 Year Lifespan"
            }
          },
          {
            "type": "badge",
            "settings": {
              "icon": "bpa",
              "label": "BPA-Free Dental Resin"
            }
          }, {
            "type": "badge",
            "settings": {
              "icon": "shipping",
              "label": "Ships Free Both Ways"
            }
          }, {
            "type": "badge",
            "settings": {
              "icon": "remake",
              "label": "Free Remakes Until It's Right"
            }
          }
        ]
      }
    ]
  }
{% endschema %}