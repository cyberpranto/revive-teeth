{% if section.settings.enable_popup %}

<div class="modal-bg" id="exitModal" role="dialog" aria-modal="true" aria-labelledby="exitTitle">

    <div class="modal exit-modal">

        <button class="modal-close" aria-label="Close" data-close>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
        </button>

        <div class="step-meta">
            {{ section.settings.eyebrow }}
        </div>

        <h3 id="exitTitle">
            {{ section.settings.heading }}
        </h3>

        <p>
            {{ section.settings.description }}
        </p>

        <form class="exit-form" id="exitForm">

            <input type="email" id="exitEmail" placeholder="{{ section.settings.placeholder }}" required
                aria-label="Email">

            <button type="submit">
                {{ section.settings.button_text }}
            </button>

        </form>

        <div id="exitSuccess" style="display:none">
            {{ section.settings.success_message }}
        </div>

        <div class="exit-or">
            or
        </div>

        <button class="btn-outline" style="width:100%;justify-content:center" id="exitTakeQuiz">
            {{ section.settings.quiz_button }}
        </button>

        <p class="exit-mini">
            {{ section.settings.footer_text }}
        </p>

    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

  const exitForm = document.getElementById('exitForm');

  if (!exitForm) return;

  exitForm.addEventListener('submit', async (e) => {

    e.preventDefault();

    const email = document.getElementById('exitEmail').value;

    try {

      const response = await fetch(
        'https://manage.kmail-lists.com/ajax/subscriptions/subscribe',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            g: '{{ section.settings.klaviyo_list_id }}',
            email: email
          })
        }
      );

      if (!response.ok) {
        throw new Error('Subscription failed');
      }

      document.getElementById('exitTitle').textContent =
        {{ section.settings.success_title | json }};

      exitForm.style.display = 'none';

      document.getElementById('exitSuccess').style.display = 'block';

      setTimeout(() => {
        closeModal('exitModal');
      }, 1500);

    } catch (error) {

      console.error('Klaviyo error:', error);

    }

  });

});
</script>

{% endif %}


{% schema %}
{
"name": "Exit Intent Popup",
"settings": [
{
"type": "checkbox",
"id": "enable_popup",
"label": "Enable Popup",
"default": true
},
{
"type": "text",
"id": "klaviyo_list_id",
"label": "Klaviyo List ID"
},
{
"type": "text",
"id": "eyebrow",
"label": "Eyebrow",
"default": "Before you go"
},
{
"type": "text",
"id": "heading",
"label": "Heading",
"default": "Not sure if Revive Veneers are right for you?"
},
{
"type": "textarea",
"id": "description",
"label": "Description"
},
{
"type": "text",
"id": "placeholder",
"label": "Email Placeholder",
"default": "you@example.com"
},
{
"type": "text",
"id": "button_text",
"label": "Submit Button",
"default": "Send Guide"
},
{
"type": "text",
"id": "quiz_button",
"label": "Quiz Button",
"default": "Take the 30-second Smile Assessment"
},
{
"type": "text",
"id": "footer_text",
"label": "Footer Text",
"default": "No spam. Unsubscribe anytime."
},
{
"type": "text",
"id": "success_title",
"label": "Success Title",
"default": "Check your inbox."
},
{
"type": "text",
"id": "success_message",
"label": "Success Message",
"default": "Your guide has been sent."
}
],
"presets": [
{
"name": "Exit Intent Popup"
}
]
}
{% endschema %}